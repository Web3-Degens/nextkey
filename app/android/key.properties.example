# Copy to android/key.properties and fill in. That file is in .gitignore and
# must stay there: an upload key committed once is committed for good, and Play
# will not accept a replacement for an app that is already published without
# going through key reset.
#
# Create the keystore once, and back it up somewhere that is not this repo —
# losing it means losing the ability to update the published app:
#
#   mkdir %USERPROFILE%\keys
#   keytool -genkeypair -v -keystore %USERPROFILE%\keys\nextkey-upload.p12 -storetype PKCS12 -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# PKCS12 rather than the older JKS: same result, no deprecation warning, and one
# password instead of two — with PKCS12 the two lines below hold the same value.
#
# Backslashes are doubled. With single ones Gradle does not find the file and
# signs with the debug key instead, which Play refuses at upload.
storePassword=
keyPassword=
keyAlias=upload
storeFile=C:\\Users\\<you>\\keys\\nextkey-upload.p12
